# MongoDB connection string used by Better Auth and the listings catalog
MONGODB_URI=mongodb+srv://user:password@cluster.example.com/

# Better Auth
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-long-random-string

# Social providers (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Comma-separated emails promoted on sign-up (never exposed in the sign-up form)
ADMIN_EMAILS=
VENDOR_EMAILS=

# ImgBB API key — kept server-side; profile images are uploaded through /api/upload/image
IMGBB_API_KEY=

# Express backend (when connected)
NEXT_PUBLIC_API_URL=http://localhost:8000
